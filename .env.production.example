# Production environment — copy to .env.production.local and fill in values.
# Store secrets in GitHub Actions secrets (for CI/CD) or Fly.io secrets (fly secrets set KEY=value).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Admin panel
ADMIN_SECRET_KEY=""

# Razorpay (https://dashboard.razorpay.com/app/website-app-settings/api-keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Test environment — used by Vitest (unit tests) and Playwright E2E in CI.
# These are safe placeholder values. E2E tests mock Supabase network calls
# via Playwright route interception; no real Supabase instance is required.

# Supabase (unit tests use mocks; E2E uses route interception)
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="test-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="test-service-role-key-placeholder"

# App URL
NEXTAUTH_URL="http://localhost:3000"

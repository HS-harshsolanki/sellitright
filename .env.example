# Development environment — copy to .env.local and fill in values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin panel
ADMIN_SECRET_KEY="dev-admin-secret"
# Signs the admin httpOnly session cookie — should be distinct from ADMIN_SECRET_KEY
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Razorpay (https://dashboard.razorpay.com/app/website-app-settings/api-keys)
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose in the browser (it's the public key)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# MSG91 SMS OTP verification
# Signup: https://msg91.com → Dashboard → API keys
# MSG91_AUTH_KEY: from MSG91 Dashboard → Settings → API keys
# MSG91_TEMPLATE_ID: from MSG91 Dashboard → SMS → Templates (after creating OTP template)
# When these are blank, OTPs are logged to the console instead of being sent (dev mode).
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# OTP security
# HMAC secret for signing OTP hashes — generate with: openssl rand -hex 32
# Default is "dev-otp-secret" when blank (not safe for production)
OTP_HMAC_SECRET=""

# Active payment gateway: razorpay | cashfree | phonepe (default: razorpay)
ACTIVE_GATEWAY="razorpay"

# PhonePe PG (https://developer.phonepe.com → Sandbox credentials)
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="sandbox"  # sandbox | production

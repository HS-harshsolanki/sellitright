# Development environment — copy to .env.local and fill in values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin panel
ADMIN_SECRET_KEY="dev-admin-secret"
# Signs the admin httpOnly session cookie — should be distinct from ADMIN_SECRET_KEY
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Razorpay (https://dashboard.razorpay.com/app/website-app-settings/api-keys)
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose in the browser (it's the public key)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# WhatsApp OTP verification (Meta Business — WhatsApp Cloud API)
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# WHATSAPP_PHONE_NUMBER_ID: the phone number ID from Meta Business → WhatsApp → API Setup
# WHATSAPP_ACCESS_TOKEN: system-user permanent token (not page token — that expires)
# WHATSAPP_OTP_TEMPLATE: approved template name (default: otp_verification)
# When these are blank, OTPs are logged to the console instead of being sent (dev mode).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_OTP_TEMPLATE="otp_verification"

# OTP security
# HMAC secret for signing OTP hashes — generate with: openssl rand -hex 32
# Default is "dev-otp-secret" when blank (not safe for production)
OTP_HMAC_SECRET=""

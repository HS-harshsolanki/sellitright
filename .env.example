# Development environment — copy to .env.local and fill in values.
# For staging, see .env.staging.example instead.

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment identifier: "production" | "staging"
# Controls robots.txt, staging banner, and feature gates.
# On Fly.io this is injected as a build-arg in deploy.yml / deploy-staging.yml.
NEXT_PUBLIC_APP_ENV="development"

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL — from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
# Anon/public key — from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key (server-side only, never expose to browser)
# from Supabase dashboard → Settings → API
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Admin panel ──────────────────────────────────────────────────────────────
# Secret used to authenticate admin API calls
ADMIN_SECRET_KEY="dev-admin-secret"
# Signs the admin httpOnly session cookie — should be distinct from ADMIN_SECRET_KEY
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# API keys — https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Use rzp_test_* keys in development/staging, rzp_live_* in production.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose in the browser (it's the public key).
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret — from Razorpay dashboard → Webhooks → (your webhook) → Secret
RAZORPAY_WEBHOOK_SECRET=""

# ─── Firebase (Phone Auth) ────────────────────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# Leave blank in production. Set to "localhost" or "127.0.0.1" to use the
# Firebase Auth Emulator locally (e.g. NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost).
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=""

# Firebase Admin SDK (server-side only)
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
# Newlines in the private key must be escaped as \n (the literal two characters)
FIREBASE_ADMIN_PRIVATE_KEY=""

# ─── SMS OTP (MSG91) ──────────────────────────────────────────────────────────
# Signup: https://msg91.com → Dashboard → API keys
# MSG91_AUTH_KEY: Settings → API keys
# MSG91_TEMPLATE_ID: SMS → Templates (after creating OTP template)
# When both are blank, OTPs are logged to the console instead (dev mode).
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# ─── WhatsApp OTP (Meta Business / WhatsApp Cloud API) ───────────────────────
# Meta Business Manager → WhatsApp → API Setup
# WHATSAPP_PHONE_NUMBER_ID: the numeric phone number ID for your business number
# WHATSAPP_ACCESS_TOKEN: permanent/system-user token from Meta Business Manager
# WHATSAPP_OTP_TEMPLATE: name of the approved WhatsApp message template (default: otp_verification)
# When blank, the app falls back to MSG91 / console logging.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_OTP_TEMPLATE="otp_verification"

# ─── OTP Security ─────────────────────────────────────────────────────────────
# HMAC secret for signing OTP hashes — generate with: openssl rand -hex 32
# Default is "dev-otp-secret" when blank (not safe for production)
OTP_HMAC_SECRET=""

# ─── Beta access ──────────────────────────────────────────────────────────────
# Optional invite-only beta gate. Leave blank to disable.
BETA_ACCESS_CODE=""

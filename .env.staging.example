# Staging environment — copy to .env.staging.local and fill in real values.
# NEVER commit .env.staging or .env.staging.local to git.
# Add all secrets to GitHub Actions: Settings → Secrets and variables → Actions.

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL of the staging deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=https://staging.chapternew.com

# Must be "staging" — controls robots.txt noindex, staging banner, and feature gates
NEXT_PUBLIC_APP_ENV=staging

# Always "production" on Fly.io (Next.js build mode); do not change
NODE_ENV=production

# ─── Supabase (staging project) ───────────────────────────────────────────────
# Create a separate Supabase project for staging at https://supabase.com
# Use a DIFFERENT project from production to prevent data leakage.
# Project URL — Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon/public key — Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXX

# Service role key (server-side only, never expose to browser)
# Supabase dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXX

# ─── Admin panel ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# Signs the admin httpOnly session cookie — must be different from ADMIN_SECRET_KEY
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=REPLACE_WITH_GENERATED_SECRET

# ─── Razorpay (TEST keys — staging must NEVER use live keys) ─────────────────
# Razorpay dashboard → Settings → API Keys → Test mode keys
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXX
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Webhook secret for staging — configure a separate webhook in Razorpay test mode
# Razorpay dashboard → Settings → Webhooks → Add New Webhook (use staging URL)
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# ─── Firebase (Phone Auth — staging project) ──────────────────────────────────
# Use a SEPARATE Firebase project for staging (or the same project with test phone numbers).
# Firebase console → Project settings → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-staging-project

# Leave blank — emulator is only for local dev, not Fly.io staging
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=

# Firebase Admin SDK (server-side only)
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-staging-project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-staging-project.iam.gserviceaccount.com
# Escape newlines as \n (literal backslash-n) — do NOT use actual line breaks
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXX\n-----END PRIVATE KEY-----\n"

# ─── SMS OTP (MSG91 — test account or same account with test numbers) ─────────
# https://msg91.com → Dashboard → API keys
# When blank, OTPs are logged to the console (useful for internal staging testing).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ─── WhatsApp OTP (Meta Business — same account, test mode recommended) ───────
# Meta Business Manager → WhatsApp → API Setup
# Leave blank to fall back to MSG91 / console logging on staging.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=otp_verification

# ─── OTP Security ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=REPLACE_WITH_GENERATED_SECRET

# ─── Beta access ──────────────────────────────────────────────────────────────
# Optional gate for staging. Set a simple code for internal testers.
BETA_ACCESS_CODE=
